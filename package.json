{
  "name": "splinterlands-mcp",
  "version": "1.0.3",
  "description": "Read-only MCP server for the Splinterlands public API.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "splinterlands-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "library"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "build": "tsup && node -e \"require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "test": "npm run build && vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "leak-check": "tsx scripts/leak-check.ts --ci",
    "leak-check:full": "tsx scripts/leak-check.ts --full",
    "drift:check": "tsx scripts/drift-check.ts",
    "drift:spec": "tsx scripts/spec-diff.ts",
    "drift:fixtures": "tsx scripts/fixture-refresh.ts",
    "drift:baseline": "tsx scripts/gen-drift-baseline.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "sharp": "0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Silverkazimi/splinterlands-mcp.git"
  },
  "homepage": "https://github.com/Silverkazimi/splinterlands-mcp#readme",
  "bugs": {
    "url": "https://github.com/Silverkazimi/splinterlands-mcp/issues"
  }
}
